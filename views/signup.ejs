<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <title>Sign Up — ResumeBuilder</title>
  <link rel="stylesheet" href="/css/all/utils.css">
  <link rel="stylesheet" href="/css/all/header.css">
  <link rel="stylesheet" href="/css/all/navbar.css">
  <link rel="stylesheet" href="/css/all/footer.css">
  <link rel="stylesheet" href="/css/all/darkmode.css">

  <link rel="stylesheet" href="/css/auth.css">
</head>
<body>

  <header class="site-header">
    <div class="container navbar">
      <a href="/user/" class="logo">
        <span class="logo-mark">R</span>
        <span>ResumeBuilder</span>
      </a>
      <nav class="nav-links">
        <a href="/user/">Home</a>
        <a href="/user/gallery">Templates</a>
        <a href="/user/login">Login</a>
      </nav>
      <div class="nav-actions">
        <button class="btn-theme-toggle" id="theme-toggle" aria-label="Toggle dark mode">
          <span class="theme-icon"><i class="bi bi-circle-half"></i></span>
        </button>
        <a href="/user/login" class="btn btn-primary">Log In</a>
      </div>
    </div>
  </header>

  <main>
    <section class="auth-section">
      <div class="auth-card">

        <div class="auth-logo">
          <span class="logo-mark">R</span>
          <span class="auth-logo-name">ResumeBuilder</span>
        </div>

        <h1 class="auth-heading">Create your account</h1>
        <p class="auth-sub">Free forever. No credit card needed.</p>

        <!-- Server error banner -->
        <div class="server-error" id="serverError" style="display:none;">
          <i class="bi bi-exclamation-circle-fill"></i>
          <span id="serverErrorMsg"></span>
        </div>

        <!-- Pending approval banner -->
        <div class="pending-banner" id="pendingBanner" style="display:none;">
          <i class="bi bi-hourglass-split"></i>
          <div>
            <strong>Application submitted!</strong>
            <p>Your recruiter account is pending admin approval. You'll be able to log in once approved.</p>
          </div>
        </div>

        <form class="auth-form" id="myForm" novalidate>

          <div class="name-row">
            <div class="field">
              <label for="first-name">First name</label>
              <input type="text" id="first-name" name="firstName" placeholder="Jane" autocomplete="given-name">
              <span class="err" id="fnameErr"></span>
            </div>
            <div class="field">
              <label for="last-name">Last name</label>
              <input type="text" id="last-name" name="lastName" placeholder="Smith" autocomplete="family-name">
              <span class="err" id="lnameErr"></span>
            </div>
          </div>

          <div class="field">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" placeholder="you@example.com" autocomplete="email">
            <span class="err" id="mailErr"></span>
          </div>

          <div class="field">
            <label for="password">Password</label>
            <input type="password" id="password" name="password" placeholder="Min. 8 characters" autocomplete="new-password">
            <span class="err" id="passErr"></span>
          </div>

          <!-- Role selector -->
          <div class="field">
            <label for="role">I am a</label>
            <select id="role" name="role" class="auth-select">
              <option value="jobseeker">Job Seeker</option>
              <option value="recruiter">Recruiter</option>
            </select>
          </div>

          <!-- Recruiter note — shown when recruiter is selected -->
          <div class="recruiter-note" id="recruiterNote" style="display:none;">
            <i class="bi bi-info-circle-fill"></i>
            Recruiter accounts require admin approval before you can log in.
          </div>

          <button type="submit" class="btn btn-primary btn-full" id="submitBtn">
            <span id="submitText">Create account</span>
            <span id="submitSpinner" style="display:none;"><i class="bi bi-arrow-repeat spin"></i></span>
          </button>

        </form>

        <p class="auth-footer">
          Already have an account? <a href="/user/login">Log in</a>
        </p>

      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="container footer-inner-simple">
      <nav class="footer-links" style="flex-direction:row;">
        <a href="#">About</a>
        <a href="#">Privacy</a>
        <a href="#">Terms</a>
      </nav>
      <p class="copyright">© 2026 ResumeBuilder. All rights reserved.</p>
    </div>
  </footer>

  <script src="/js/signupValidation.js" defer></script>
  <script src="/js/darkmode.js"></script>

</body>
</html>
