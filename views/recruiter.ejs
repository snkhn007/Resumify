<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Recruiter Portal</title>

  <!-- Global Styles -->
  <link rel="stylesheet" href="/css/utils.css" />
  <link rel="stylesheet" href="/css/header.css" />
  <link rel="stylesheet" href="/css/footer.css" />

  <!-- Page Styles -->
  <link rel="stylesheet" href="/css/recruiter.css" />
</head>

<body>

<!-- HEADER -->
<header class="site-header">
  <div class="container navbar">

    <a href="/" class="logo">
      <div class="logo-mark">R</div>
      ResumeHub
    </a>

    <div class="nav-links">
      <a href="#" class="active" onclick="switchView('browse')">Browse</a>
      <a href="#" onclick="switchView('shortlist')">
        Shortlist <span class="badge" id="shortlist-count">0</span>
      </a>
    </div>

    <div class="nav-actions">
      <button class="btn btn-light" onclick="logout()">Logout</button>
    </div>

  </div>
</header>

<!-- MAIN -->
<main>
  <div class="container">

    <!-- BROWSE VIEW -->
    <div class="view active" id="view-browse">

      <!-- Filters -->
      <div class="filters-bar">
        <div class="search-wrap">
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"/>
            <path d="m21 21-4.35-4.35"/>
          </svg>
          <input type="text" id="searchInput" placeholder="Search resumes..." />
        </div>

        <select id="skillFilter">
          <option value="">All Skills</option>
          <option>JavaScript</option>
          <option>Python</option>
          <option>React</option>
        </select>

        <select id="templateFilter">
          <option value="">All Templates</option>
          <option>Classic</option>
          <option>Modern</option>
        </select>

        <button class="btn btn-primary" onclick="fetchResumes(1)">Search</button>
        <button class="btn btn-light" onclick="clearFilters()">Clear</button>
      </div>

      <!-- Cards -->
      <div id="cards-container"></div>

      <!-- Pagination -->
      <div class="pagination" id="pagination"></div>
    </div>

    <!-- SHORTLIST -->
    <div class="view" id="view-shortlist">
      <h2 class="section-title">Shortlisted Candidates</h2>
      <p class="text-muted">Candidates you've saved</p>
      <div id="shortlist-container"></div>
    </div>

  </div>
</main>

<!-- MODAL -->
<div class="modal-overlay" id="resumeModal">
  <div class="modal">
    <div class="modal-header">
      <h3 id="modal-title">Resume</h3>
      <button onclick="closeModal()">×</button>
    </div>
    <div id="modal-body"></div>
    <div class="modal-footer">
      <button class="btn btn-light" onclick="closeModal()">Close</button>
      <button class="btn btn-primary" id="modal-shortlist-btn">Shortlist</button>
    </div>
  </div>
</div>

<!-- TOAST -->
<div id="toast" class="toast"></div>

<script>
let currentPage = 1;
let shortlistIds = new Set();

/* INIT */
document.addEventListener('DOMContentLoaded', () => {
  fetchResumes(1);
  loadShortlistIds();
});

/* SWITCH VIEW */
function switchView(name) {
  document.querySelectorAll('.view').forEach(v => v.classList.remove('active'));
  document.getElementById('view-' + name).classList.add('active');
}

/* FETCH */
async function fetchResumes(page = 1) {
  const container = document.getElementById('cards-container');
  container.innerHTML = 'Loading...';

  try {
    const res = await fetch('/api/recruiter/resumes');
    const data = await res.json();

    renderCards(data.resumes || [], container);
  } catch {
    container.innerHTML = 'Error loading resumes';
  }
}

/* RENDER */
function renderCards(resumes, container) {
  if (!resumes.length) {
    container.innerHTML = '<p>No resumes found</p>';
    return;
  }

  let html = '<div class="cards-grid">';
  resumes.forEach(r => {
    html += `
      <div class="resume-card">
        <div class="card-header">
          <div class="avatar">${(r.fullName || 'U')[0]}</div>
          <button onclick="toggleShortlist('${r._id}', this)">☆</button>
        </div>

        <h4>${r.fullName || 'Unknown'}</h4>

        <div class="skills-wrap">
          ${(r.skills || '').split(',').map(s => `<span class="skill-tag">${s}</span>`).join('')}
        </div>

        <div class="card-actions">
          <button class="btn btn-primary btn-sm">View</button>
        </div>
      </div>
    `;
  });

  html += '</div>';
  container.innerHTML = html;
}

/* SHORTLIST */
async function loadShortlistIds() {
  try {
    const res = await fetch('/api/recruiter/shortlist');
    const data = await res.json();
    shortlistIds = new Set(data.resumes.map(r => r._id));
    document.getElementById('shortlist-count').textContent = shortlistIds.size;
  } catch {}
}

async function toggleShortlist(id, btn) {
  await fetch('/api/recruiter/shortlist/' + id, { method: 'PATCH' });
  btn.textContent = btn.textContent === '☆' ? '★' : '☆';
}

/* MODAL */
function closeModal() {
  document.getElementById('resumeModal').classList.remove('open');
}

/* LOGOUT */
async function logout() {
  await fetch('/api/auth/logout', { method: 'POST' });
  window.location.href = '/user/login';
}
</script>

</body>
</html>